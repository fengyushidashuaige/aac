#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Amov Jetson + PX4 overlay config."""


def apply_jetson_px4(cfg):
    cfg.camera.camera_id = 0
    cfg.camera.width = 640
    cfg.camera.height = 480
    cfg.camera.fps = 30
    # 强制 MJPG 解码，避免手动曝光后落到 YUYV 绿屏
    cfg.camera.gst_pipeline = None  # cv2 3.3.1 no GStreamer, V4L2-only
    # 户外：手动曝光 exp=1/gain=95（2026-08-13 试飞用，8-12 户外实测组合）；室内台架换回 auto_exposure=True
    # ★★ 2026-09-18 排查: 以下相机参数【gutter_udp.py 根本没应用】, 改这里不影响板上行为!
    #    gutter_udp.py 只读了 camera_id / width / height, 相机控制全在它自己的
    #    cam_init() + ae_step() 里用 v4l2-ctl 直接下发给驱动。
    #    实际生效值见 cam_init(): gain=60 exp=128 gamma=100 brightness=0 AWB=自动。
    cfg.camera.auto_exposure = True   # ← 以下均为死配置, 勿信
    cfg.camera.adaptive_exposure = False
    cfg.camera.exposure_absolute = 3    # 2026-08-14 中午: 1→3(用户要求,配 gain=130)
    cfg.camera.gain = 100               # 2026-08-14 中午: 130→100(用户要求,配 exp=3)
    cfg.camera.brightness = 0
    cfg.camera.contrast = 4
    cfg.camera.sharpness = 1
    cfg.camera.backlight_compensation = 4
    cfg.camera.focus_auto = True    # DCGX200 定焦镜头, 不干预对焦
    cfg.camera.focus_absolute = 500
    cfg.camera.auto_white_balance = True
    cfg.camera.power_line_frequency = 1

    cfg.yolo.enabled = True
    cfg.yolo.weights = "models/gutter_seg_320.engine"
    # 侧向/户外：更低门限 + 推理轻模糊抗果冻
    cfg.yolo.conf = 0.06
    cfg.yolo.imgsz = 320
    cfg.yolo.device = "cuda"
    cfg.yolo.candidate_conf = 0.018
    cfg.yolo.fallback_conf = 0.010
    cfg.yolo.mask_threshold_low = 0.20
    cfg.yolo.mask_threshold_high = 0.28
    cfg.yolo.extend_mask = False
    cfg.yolo.mask_bottom_ignore = 0.20
    cfg.yolo.ctrl_y_frac = 0.40
    cfg.yolo.infer_blur_ksize = 3

    cfg.control.use_mavlink = True
    cfg.control.mavlink_connection = "/dev/ttyTHS1"
    cfg.control.mavlink_baud = 921600
    cfg.control.fc_stack = "px4"
    cfg.control.auto_guided = False
    # 空中短闪烁多给一点时间，避免刚纠偏就被踢回 POSITION
    cfg.control.safety_loss_timeout = 0.8

    # ── 平滑 PD + 延迟预测（替代单轴顺序 bang-bang）──
    # vy_des = kp·(off + L·off_dot) + kd·off_dot；yaw_rate = -yaw_kp_deg·angle
    # 大偏移给足速度，接近中心自动收油，不再空转/冲过回摆
    # 死区=噪声门：|off|≤30mm 只发阻尼（不追检测白噪声），死区外全增益
    cfg.control.dead_zone_mm = 30.0    # 2026-08-13 傍晚: 试 20 无收益(锁带 49%→28-34%, 疑追检测噪声), 回 30
    cfg.control.dead_zone_deg = 2.5
    # 2026-09-12: 接受门限 0.3->0.6, 剔除吹风筒误检
    # ★ 2026-09-18 勘误: 真正生效的 conf 门限在 ~/guttermap/servo_track.py 的
    #   MIN_CONF (硬编码在那里, 不读本配置)。本项只给 controller.py 用, 而
    #   controller.py 属于 gutter_track(纯追踪)路线 —— 视觉伺服路线不走这里。
    cfg.control.min_accept_conf = 0.6
    cfg.control.lateral_kp = 0.05
    cfg.control.lateral_kd = 0.0
    # 2026-08-13 试飞: 0.08→0.03；2026-08-13 下午回搬旧版力度(旧firefly 0.10, GUIDED)第一步→0.06
    # 2026-08-13 傍晚实飞: vy 打满率 43-63% 仍 ±0.4m 极限环扫荡, 幻影已除 → 回旧版 0.10
    cfg.control.max_lateral_speed = 0.075  # 2026-08-14 中午: 0.10→0.075
    # (对比昨晚: vy打满0%且conf低→75%折扣→实际≤0.075m/s; 今天conf≥0.8折扣消失满0.10凶
    #  34-46%打满+0.12Hz摆动 → 回到昨晚的有效横移力度)
    cfg.control.lateral_slew_rate = 0.15
    cfg.control.lateral_slew_rate_down = 0.60
    cfg.control.lateral_soft_zone_mm = 60.0
    cfg.control.yaw_kp = 0.025
    cfg.control.yaw_kd = 0.0
    # 连续比例偏航，大角度(>20°)给到 0.09，近中心自动收小
    # 2026-08-13 试飞: 0.09→0.04；2026-08-13 下午回搬旧版力度(旧firefly 0.09)第一步→0.06
    # 2026-08-13 傍晚实飞: 角度±7°@0.9Hz晃, 0.06限幅掰不回(有效仅2.1°/s) → 0.12(×2, 6°给满)
    # 2026-08-13 晚: 0.12→0.18 实飞恶化——自旋扫线被横向满增益追(角度sd 12.1 vs 4.6,
    # offset ±450mm 循环, angle 领先 offset 1.3s) → 回 0.12; 正解是偏航旋转率解耦(见下回)
    cfg.control.max_yaw_rate = 0.12
    cfg.control.yaw_slew_rate = 0.25
    cfg.control.yaw_priority_deg = 8.0
    cfg.control.vy_during_yaw_scale = 0.0    # (旧字段，新控制不再用)
    cfg.control.yaw_during_lat_scale = 0.0   # (旧字段，新控制不再用)
    # 纯偏航门限: |angle|>20° 时横移只留 25%（斜角下图像偏移失真）
    cfg.control.yaw_only_gate_deg = 20.0
    cfg.control.vy_in_yaw_gate_scale = 0.25
    cfg.control.yaw_kp_deg = 0.012           # yaw_rate = -0.012·angle (rad/s) 2026-08-14 中午: 0.020→0.012
    # (13:43实飞: yaw打满34% 角±7.3°@0.12Hz bang-bang极限环, angle领先offset 1.3s 驱动横移晃;
    #  0.020在6°就顶满0.12没有比例区 → 降到10°才满, 恢复比例收敛)
    # 2026-08-13 试飞: 0.0008→0.0002；2026-08-13 下午回搬→0.0005（100mm处0.05，120mm满速0.06）
    # 2026-08-13 傍晚: 摆幅±250mm@0.25Hz 停在死区边界锁不住 → 回搬 0.0008 加对中刚度
    cfg.control.offset_kp_s = 0.0008
    cfg.control.offset_kd_s = 0.001    # 2026-08-14 中午: 0.0003→0.001(13:53实飞 yaw降后仍±350mm@0.12Hz
    # 刹车晚: 冲进死区时 ~100-300mm/s 只有 0.03-0.09 制动指令, 冲过头才反向 → 阻尼×3, 100mm/s即满刹)
    cfg.control.offset_pred_latency_s = 0.25
    cfg.control.offset_deriv_tau_s = 0.35
    cfg.control.max_ctrl_offset_mm = 500.0
    cfg.control.forward_speed = 0.05
    cfg.control.max_forward_speed = 0.08
    cfg.control.forward_slew_rate = 0.08
    cfg.control.forward_min_scale = 0.40    # 2026-08-13 回搬旧版: 未锁也按对齐比例小步前进
    cfg.control.forward_align_offset_mm = 55.0
    cfg.control.forward_align_angle_deg = 10.0
    # 巡航锁: 对中且接近速度慢才锁；锁内保留 85% 增益主动对中（2026-08-13 回搬旧版 0.35→0.85，不再开环飘）。
    # 锁心带放宽到漂移幅度量级（对中由闭环本身保证，锁心只是巡航模式门限）
    cfg.control.cruise_lock_offset_mm = 60.0
    cfg.control.cruise_lock_angle_deg = 8.0
    cfg.control.cruise_unlock_offset_mm = 100.0
    cfg.control.cruise_unlock_angle_deg = 14.0
    cfg.control.cruise_lock_frames = 8
    cfg.control.cruise_lock_od_mm_s = 30.0
    cfg.control.cruise_unlock_od_mm_s = 55.0
    cfg.control.cruise_vy_scale = 0.15
    cfg.control.cruise_yaw_scale = 0.0
    cfg.control.cruise_corr_scale = 0.85    # 2026-08-13 回搬旧版(旧firefly 0.85)

    # 巡线实飞：叠加 + 原图（直路训练用 raw.avi）
    cfg.debug.save_video = True
    cfg.debug.save_raw_video = False
    cfg.debug.raw_record_every_n = 1
    cfg.debug.print_offset = True
    # 逐帧网页预览；录像隔帧写，控制编码负载
    cfg.debug.preview_width = 480
    cfg.debug.preview_jpeg_quality = 50
    cfg.debug.preview_every_n = 1
    cfg.debug.record_every_n = 2
    return cfg
