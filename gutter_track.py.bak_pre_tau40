#!/usr/bin/env python2
# -*- coding: utf-8 -*-
"""
循迹控制节点 (框架) —— 沿 path.csv 自动飞

★ 串口问题: 【不直接开串口】, 全部走 mavros
    mavros 已经占着 /dev/ttyTHS1 并往飞控发 vision_pose
    本节点只发 ROS 话题 -> mavros -> 串口 -> 飞控
    所以可以和雷达定位【同时运行】

指令:  /mavros/setpoint_velocity/cmd_vel  (TwistStamped, 机体系速度+yaw速率)

安全:  只有 enable=True 且飞控 armed 才发指令, 否则发零速
    bash: rosservice call /gutter_track/set_enable true
"""
import math, socket, json, csv, threading, time
import numpy as np
import rospy
from nav_msgs.msg import Odometry
from geometry_msgs.msg import TwistStamped
from std_srvs.srv import SetBool, SetBoolResponse

import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from pursuit import Polyline, PurePursuit

UDP_PORT = 45679          # 相机偏移 (gutter_udp 在发)
K_CAM = 0.5        # (停用中) 相机航向项增益
PSI_TAU = 0.6      # (停用中) 航向低通时间常数


def load_path(path):
    pts = []
    with open(path) as f:
        for i, ln in enumerate(f):
            if i == 0 and not (ln[0].isdigit() or ln[0] == '-'):
                continue
            p = ln.strip().split(',')
            if len(p) >= 2:
                try:
                    pts.append((float(p[0]), float(p[1])))
                except ValueError:
                    pass
    return pts


class Tracker(object):
    def __init__(self):
        path_file = rospy.get_param('~path', '')
        self.v_cruise = rospy.get_param('~v_cruise', 0.3)
        self.lookahead = rospy.get_param('~lookahead', 0.8)
        self.rate_hz = rospy.get_param('~rate', 20.0)
        self.use_cam = rospy.get_param('~use_cam', True)   # 阶段2 打开

        pts = load_path(path_file)
        rospy.loginfo('[track] 载入路径 %s: %d 点' % (path_file, len(pts)))
        self.pl = Polyline(pts).smooth(win=5, passes=2)
        self.pp = PurePursuit(self.pl, v_cruise=self.v_cruise,
                              lookahead=self.lookahead, slow_radius=1.0,
                              max_yaw_rate=0.4, max_vy=0.15, cte_gain=0.8)

        self.pose = None          # (x, y, yaw)
        self.speed = 0.0
        self.armed = False
        self.enable = False
        self.cam_off = None       # 相机偏移(mm), 阶段2 用
        self.cam_t = 0.0
        self.off_lp = 0.0
        self.cte_lp = None
        self.lat_shift = 0.0
        # 使能后"先对齐再前进"(2026-09-24): 飞手悬停压不到 cte<50,
        # 实测两趟都是带 200~270mm 偏差使能 -> 带偏差往前冲 + 过冲
        self.align_t0 = None
        self.align_done = False
        self.align_logged = False
        self.ready_logged = False    # 悬停"就绪"标志, 只在跳变时打一次
        self.wpx_buf = []          # 近 200 帧 wpx (用85百分位当参考, EMA会被坏帧拖垮)
        self.cam_ang = None       # 相机倾角(度)
        self.hgt = 0.4            # 当前高度(雷达 z)
        self.psi_lp = 0.0
        self.use_cam_head = bool(rospy.get_param('~use_cam_heading', False))
        self.align_gate = bool(rospy.get_param('~align_gate', True))
        self.align_cte = float(rospy.get_param('~align_cte', 0.06))
        self.align_to = float(rospy.get_param('~align_timeout', 90.0))
        self.log_dt = 1.0 / max(float(rospy.get_param('~log_hz', 10.0)), 1.0)
        self.psi_cam = None
        self.cal = None
        try:
            _cp = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'ang_cal.json')
            if os.path.exists(_cp):
                self.cal = json.load(open(_cp))
                rospy.logwarn('[track] 角度标定已载入 A=%.3f B=%.3f C=%.3f (%s, CV中位 %.1f deg)'
                              % (self.cal['A'], self.cal['B'], self.cal['C'],
                                 self.cal.get('model', '?'), self.cal.get('cv_med_deg', -1)))
        except Exception as _e:
            rospy.logwarn('[track] 角度标定载入失败: %s' % _e)
        self.last_print = 0.0

        rospy.Subscriber('/Odometry', Odometry, self.on_odom, queue_size=10)
        self.pub = rospy.Publisher('/mavros/setpoint_velocity/cmd_vel',
                                   TwistStamped, queue_size=1)
        rospy.Service('~set_enable', SetBool, self.on_enable)

        threading.Thread(target=self.udp_loop).start()
        rospy.Timer(rospy.Duration(1.0 / self.rate_hz), self.control)

    # ---------- 输入 ----------
    def update_cam_heading(self, dt):
        """相机直接测的航向误差 psi(机头相对槽). 系数由 ang_cal.py 标定.
        tan(tilt) = A*tan(psi) + B*(d/h) + C  =>  psi = atan((tan(tilt)-B*d/h-C)/A)
        实测交叉验证: 中位 3.2deg / P90 5.6deg.
        """
        if self.cal is None or self.cam_ang is None or self.cam_off is None:
            self.psi_cam = None
            return
        A = float(self.cal['A']); B = float(self.cal['B']); C = float(self.cal['C'])
        if abs(A) < 1e-6:
            self.psi_cam = None
            return
        h = max(float(self.hgt), 0.10)
        d = self.cam_off / 1000.0
        t = math.tan(math.radians(self.cam_ang))
        psi = math.atan((t - B * (d / h) - C) / A)
        if abs(psi) > math.radians(45):
            self.psi_cam = None          # 离谱, 不要
            return
        a = 1.0 - math.exp(-dt / max(PSI_TAU, 1e-3))
        self.psi_lp += a * (psi - self.psi_lp)
        self.psi_cam = psi
        return

    def update_cam_fix(self, c):
        # 2026-09-23: cam_off 由 udp 线程写, 随时可能变 None。
        # 快照成局部变量, 否则两次读之间它变 None -> abs(None) 崩溃,
        # 控制线程死掉 -> setpoint 断流 -> PX4 退出 OFFBOARD。
        _off = self.cam_off
        if not (self.use_cam and _off is not None):
            return                        # 无有效数据: 冻结上一值, 不归零
        TAU = float(rospy.get_param('~cam_tau', 15.0))   # 慢: 滞后~0.5s, 15:1 裕度足够
        dt = 1.0 / max(self.rate_hz, 1.0)
        # 门: 只卡"偏差本身不可信"(坏 mask); 不卡 cte —— 路径偏了也要能纠回来(鲁棒性)
        if abs(_off) > 250.0:
            return
        a = 1.0 - math.exp(-dt / TAU)
        self.off_lp += a * (_off / 1000.0 - self.off_lp)
        if self.cte_lp is None:
            self.cte_lp = c.cte_raw
        else:
            self.cte_lp += a * (c.cte_raw - self.cte_lp)
        tgt = -self.off_lp   # 2026-09-24: 原 cte_lp-off_lp 把"飞机跟路径的误差"也塞进相机目标,
        #   cte 的摆动直接叠到 lat_shift 上 -> flyI 过冲到 -133mm(需要只有 -55mm).
        #   相机只管"路径 vs 槽"的偏差; "飞机 vs 路径"交还给纯追踪.
        _d = a * (tgt - self.lat_shift)
        _cap = float(rospy.get_param('~cam_rate', 0.01)) * dt   # 10mm/s, 顶不上去
        self.lat_shift += max(-_cap, min(_cap, _d))
        _lim = float(rospy.get_param('~cam_lim', 0.5))
        self.lat_shift = max(-_lim, min(_lim, self.lat_shift))

    def on_odom(self, m):
        q = m.pose.pose.orientation; p = m.pose.pose.position
        x, y, z, w = q.x, q.y, q.z, q.w
        yaw = math.atan2(2*(w*z + x*y), 1 - 2*(y*y + z*z))
        self.pose = (p.x, p.y, yaw)
        self.hgt = p.z
        v = m.twist.twist.linear
        self.speed = math.hypot(v.x, v.y)

    def udp_loop(self):
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            s.bind(('127.0.0.1', UDP_PORT)); s.settimeout(1.0)
        except Exception as e:
            rospy.logwarn('[track] UDP %d 绑定失败: %s (可能 gutter_udp 没在跑)' % (UDP_PORT, e))
            return
        while not rospy.is_shutdown():
            try:
                d, _ = s.recvfrom(1024)
                j = json.loads(d.decode('utf-8'))
                ok = (j.get('detected') and not j.get('held')
                      and j.get('conf', 0) >= 0.6)
                _off = float(j.get('offset_mm', 0.0) or 0.0)
                _w = float(j.get('wpx', 0.0) or 0.0)
                _ang = float(j.get('angle_deg', 0.0) or 0.0)
                if ok and abs(_ang) > 45.0:
                    ok = False        # 倾角超物理上限 -> 坏 mask
                # 门1: 物理上限. mask 被截断时检测器给出 -846/-1252mm 这种
                #   不可能的值(相机横向视野只有 ±250mm), 而 conf 是模型分主导挡不住.
                if ok and abs(_off) > 250.0:
                    ok = False
                # 门2: wpx 相对滑动参考的带宽(mask 截断会让 wpx 偏小)
                if ok and _w > 1.0:
                    self.wpx_buf.append(_w)
                    if len(self.wpx_buf) > 200:
                        self.wpx_buf.pop(0)
                    if len(self.wpx_buf) >= 20:
                        # ★ 参考用 85 百分位: 槽被截断只会让 wpx 变小, 所以高分位不会被拖下去
                        #   (旧的 EMA 参考会被持续 15s 的坏帧拖到 26, 门控就失效了 ✗)
                        _ref = float(np.percentile(self.wpx_buf, 85))
                        if _w < 0.75 * _ref or _w > 1.6 * _ref:
                            ok = False
                        else:
                            # ★ 尺度用参考宽度, 不用逐帧 wpx -> 截断时不再把 off 放大
                            _off = _off * _w / _ref
                if ok:
                    self.cam_off = _off
                    self.cam_ang = _ang
                    self.cam_t = time.time()
                elif time.time() - self.cam_t > 1.0:
                    self.cam_off = None
            except socket.timeout:
                pass
            except Exception:
                pass

    def on_enable(self, req):
        self.enable = bool(req.data)
        self.align_t0 = None; self.align_done = False; self.align_logged = False
        self.ready_logged = False      # 让每趟都能重新看到 OK 标志
        rospy.logwarn('[track] enable = %s' % self.enable)
        return SetBoolResponse(success=True, message='enable=%s' % self.enable)

    # ---------- 控制 ----------
    def publish(self, vx, vy, yaw_rate):
        t = TwistStamped()
        t.header.stamp = rospy.Time.now()
        t.header.frame_id = 'base_link'
        t.twist.linear.x = vx
        t.twist.linear.y = vy
        t.twist.angular.z = yaw_rate
        self.pub.publish(t)

    def control(self, ev):
        # ★ 无论什么情况都保持发流: PX4 OFFBOARD 要求 >2Hz 的持续设定点,
        #   断流会被踢出 OFFBOARD。所以没位姿/没使能时发零速, 而不是不发。
        if self.pose is None:
            self.publish(0.0, 0.0, 0.0)
            return
        x, y, yaw = self.pose

        # 安全门: 没使能 -> 发零速
        if not self.enable:
            self.publish(0.0, 0.0, 0.0)
            # ★ 2026-09-20: 未使能时也把路径投影算一遍并打印。
            #   原来这里直接 return, 地面检查时看不到 cte/herr,
            #   没法确认"飞机当前位置和路径对不对得上", 起飞后才发现就晚了。
            _c = self.pp.update(x, y, yaw, self.speed, lat_shift=self.lat_shift)
            # ★ 2026-09-24: 未使能(悬停)时【保留】相机预收敛 —— 飞机悬停时相机
            #   看得清, 用这几秒把 lat_shift 收敛到位, 一起飞就是中对中的。
            #   否则 lat_shift 从 0 起步, 限速 10mm/s 要 5.5s/0.44m 才追上 ~55mm 的
            #   路径偏差, 那 0.44m 就是肉眼可见的"开头左偏"。
            #   (原来的毛病不是"预收敛"本身, 是 tgt 里混了 cte -> 积过头;
            #    tgt 已改成 -off_lp, 预收敛现在收敛到的是正确值。)
            self.update_cam_fix(_c)

            # ★ 2026-09-24: 悬停时给一个【明确的 OK 标志】, 不用自己读 cte/herr/cam。
            #   判据 = flyK(83.6%) 使能时的状态: cte 在 ±50mm、herr 在 ±8deg。
            #   相机不是硬条件(flyK 使能时 cam=-- 也飞好了), 只作为提示。
            _rdy = (abs(_c.cte) <= 0.05
                    and abs(math.degrees(_c.heading_err)) <= 8.0)
            _rdy_cam = (not self.use_cam) or (self.cam_off is not None)
            _rdy_now = _rdy and _rdy_cam
            if _rdy_now != self.ready_logged:
                self.ready_logged = _rdy_now
                if _rdy_now:
                    rospy.logwarn('')
                    rospy.logwarn('[track] ============= OK 可以起飞了 =============')
                    rospy.logwarn('[track]   现在切 OFFBOARD 然后: '
                                  'rosservice call /gutter_track/set_enable true')
                    rospy.logwarn('[track]   cte=%+.0fmm  herr=%+.1fdeg  fix=%+.0fmm  cam=%s'
                                  % (1000 * _c.cte, math.degrees(_c.heading_err),
                                     1000 * self.lat_shift,
                                     ('%+.0f' % self.cam_off) if self.cam_off is not None else '--'))
                    rospy.logwarn('[track] ===========================================')
                    rospy.logwarn('')
                else:
                    _r = []
                    if not _rdy:
                        _r.append('cte=%+.0fmm/±50  herr=%+.1fdeg/±8'
                                  % (1000 * _c.cte, math.degrees(_c.heading_err)))
                    if not _rdy_cam:
                        _r.append('cam=-- (相机没看见槽)')
                    rospy.logwarn('[track] ---- 还没好: %s；挪一挪 ----' % '  '.join(_r))
            now = time.time()
            if now - self.last_print > self.log_dt:
                self.last_print = now
                rospy.loginfo('[track] (未使能) s=%5.2f/%.2f  cte=%+6.1fmm  '
                              'herr=%+5.1fdeg  vx=0.00 (锁着)'
                              % (_c.s, self.pl.length, 1000 * _c.cte,
                                 math.degrees(_c.heading_err)))
                rospy.loginfo('[track] (idle) fix=%+.0fmm  cam=%s  off_lp=%+.0fmm'
                              % (1000 * self.lat_shift,
                                 ('%+.0f' % self.cam_off) if self.cam_off is not None else '--',
                                 1000 * self.off_lp))
            return

        # 阶段2: 相机偏移 -> 把路径临时挪一下 (真正的"局部校正")
        if self.use_cam and self.cam_off is not None:
            pass    # TODO(阶段2): 用 cam_off 对当前前视点做横向平移

        c = self.pp.update(x, y, yaw, self.speed, lat_shift=self.lat_shift)
        self.update_cam_fix(c)
        # ★ 先对齐再前进: 对齐期间 vx=0, 只用 vy 横向收拢
        if self.align_gate and not self.align_done:
            if self.align_t0 is None:
                self.align_t0 = time.time()
            # ★ 2026-09-24: 相机没数据也不放行。flyL 就是"相机只看见 28~45% -> 预收敛
            #   没发生 -> fix 冻在 +12 -> 按未修正路径飘左 -> 槽更出画面"的死循环。
            #   宁可原地悬停等相机, 也别瞎飞。
            _cam_ok = (not self.use_cam) or (self.cam_off is not None)
            if (abs(c.cte) <= self.align_cte and _cam_ok) \
               or (time.time() - self.align_t0) >= self.align_to:
                self.align_done = True
                rospy.logwarn('[track] 对齐结束 cte=%+.0fmm cam=%s -> 开始前进'
                              % (1000 * c.cte,
                                 ('%+.0f' % self.cam_off) if self.cam_off is not None else '--'))
            else:
                c.vx = 0.0
                if not self.align_logged:
                    if not _cam_ok:
                        _why = '相机无数据(cam=--) -- 平移/转向找槽'
                    else:
                        _why = 'cte=%+.0fmm (>%.0fmm) 横向收拢' % (1000 * c.cte, 1000 * self.align_cte)
                    rospy.logwarn('[track] 对齐中 %s -> vx=0' % _why)
                    self.align_logged = True
        if self.use_cam_head:
            self.update_cam_heading(1.0 / max(self.rate_hz, 1.0))
        if self.psi_cam is not None:
            # 直接把机头压到与槽平行(喷管需要). psi=0 即机头与槽平行
            lim = self.pp.max_yaw_rate
            c.yaw_rate = max(-lim, min(lim, c.yaw_rate + K_CAM * self.psi_lp))
        if c.finished:
            rospy.loginfo('[track] 到终点'); self.enable = False
            self.publish(0.0, 0.0, 0.0)
            return
        self.publish(c.vx, c.vy, c.yaw_rate)

        now = time.time()
        if now - self.last_print > self.log_dt:
            self.last_print = now
            rospy.loginfo('[track] s=%5.2f/%.2f  cte=%+6.1fmm  herr=%+5.1fdeg  '
                          'vx=%.2f vy=%.2f yaw=%.3f  fix=%+.0fmm psi=%s cam=%s'
                          % (c.s, self.pl.length, 1000*c.cte, math.degrees(c.heading_err),
                             c.vx, c.vy, c.yaw_rate, 1000 * self.lat_shift,
                             ('%+.1f' % math.degrees(self.psi_lp)) if self.psi_cam is not None else '--',
                             ('%+.0f' % self.cam_off) if self.cam_off is not None else '--'))


if __name__ == '__main__':
    rospy.init_node('gutter_track')
    rospy.logwarn('=== gutter_track 启动 (走 mavros, 不占串口) ===')
    Tracker()
    rospy.spin()
