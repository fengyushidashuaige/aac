#!/bin/bash
# 循迹控制节点启动 (走 mavros, 不占串口)
# 用法: bash ~/guttermap/track_start.sh [path.csv]
B=/home/amov/guttermap
source /opt/ros/melodic/setup.bash
source /home/amov/fastlio_ws/devel/setup.bash
export ROS_MASTER_URI=http://192.168.144.60:11311

PATH_CSV=${1:-$B/path.csv}
if [ ! -f "$PATH_CSV" ]; then
  echo "!! 路径文件不存在: $PATH_CSV"
  echo "   先用 path_build.py 生成, 或指定: bash track_start.sh <path.csv>"
  exit 1
fi
if ! (timeout 3 rostopic list >/dev/null 2>&1); then
  echo "!! ROS master 不通, 先跑 ~/p600_fastlio/start.sh"; exit 1
fi
echo "[track] 路径: $PATH_CSV"
setsid nohup python2 -u $B/gutter_track.py _path:="$PATH_CSV" \
  > $B/run/track.log 2>&1 < /dev/null &
echo $! > $B/run/track.pid
sleep 4
echo "[track] pid=$(cat $B/run/track.pid)   日志 $B/run/track.log"
echo
echo "  使能:  rosservice call /gutter_track/set_enable true"
echo "  停止:  bash ~/guttermap/track_stop.sh"
echo "  看状态: tail -f $B/run/track.log"
