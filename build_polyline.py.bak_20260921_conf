#!/usr/bin/env python2
# -*- coding: utf-8 -*-
"""离线建图: detect.csv(过门限的槽检出) + flight.bag(位姿) -> 世界系槽中心线"""
import sys, os, csv, glob, math
import numpy as np, rosbag
from nav_msgs.msg import Odometry

BAG  = sys.argv[1]
CSVF = sys.argv[2]
CAM_DOWN = 0.55          # 相机到槽的垂距(m), 只影响绘制高度
MIN_CONF = 0.6

# --- 1) 读位姿 ---
try:
    bag = rosbag.Bag(BAG)
except Exception:
    bag = rosbag.Bag(BAG, allow_unindexed=True)
T, P, Q = [], [], []
for topic, msg, t in bag.read_messages(topics=['/Odometry']):
    p = msg.pose.pose.position; q = msg.pose.pose.orientation
    T.append(t.to_sec()); P.append((p.x, p.y, p.z)); Q.append((q.x, q.y, q.z, q.w))
bag.close()
T = np.array(T); P = np.array(P); Q = np.array(Q)
print('位姿 %d 条   %.1f ~ %.1f' % (len(T), T[0], T[-1]))

# --- 2) 读检测 ---
raw = open(CSVF, 'rb').read().replace(b'\x00', b'')
rows = []
for ln in raw.decode('utf-8', 'ignore').splitlines()[1:]:
    p = ln.split(',')
    if len(p) < 5: continue
    try: rows.append((float(p[0]), float(p[1]), float(p[2]), float(p[3]), int(p[4])))
    except: pass
good = [x for x in rows if x[3] >= MIN_CONF]
print('检测 %d 帧, 过门限 %d 帧' % (len(rows), len(good)))

def pose_at(ts):
    i = np.searchsorted(T, ts)
    i = min(max(i, 1), len(T) - 1)
    a = (ts - T[i-1]) / max(T[i] - T[i-1], 1e-6)
    p = P[i-1] + a * (P[i] - P[i-1])
    q = Q[i-1] + a * (Q[i] - Q[i-1])
    x, y, z, w = q / max(np.linalg.norm(q), 1e-9)
    R = np.array([[1-2*(y*y+z*z), 2*(x*y-z*w),   2*(x*z+y*w)],
                  [2*(x*y+z*w),   1-2*(x*x+z*z), 2*(y*z-x*w)],
                  [2*(x*z-y*w),   2*(y*z+x*w),   1-2*(x*x+y*y)]])
    return R, p

# --- 3) 投影到世界系 ---
W = []
for ts, off, ang, cf, dt in good:
    if ts < T[0] or ts > T[-1]: continue
    R, p = pose_at(ts)
    p_b = np.array([0.0, -off/1000.0, -CAM_DOWN])   # 机体系: x前 y左 z上
    W.append(R.dot(p_b) + p)
W = np.array(W)
print('投影出 %d 个世界系点' % len(W))
if len(W) < 10:
    print('!! 点太少'); sys.exit(0)

print()
print('=== 世界系槽点 ===')
for i, ax in enumerate('xyz'):
    print('  %s 范围 [%+.2f, %+.2f]  跨度 %.2f m' % (ax, W[:,i].min(), W[:,i].max(), W[:,i].max()-W[:,i].min()))
print('  路径长度 %.2f m' % np.linalg.norm(np.diff(W, axis=0), axis=1).sum())

# --- 4) 直线拟合看是不是一条线 ---
c = W.mean(axis=0)
u, s, vt = np.linalg.svd(W - c, full_matrices=False)
d = vt[0]
print()
print('=== 线性度 (拟合一条直线) ===')
print('  主方向 [%+.3f, %+.3f, %+.3f]   奇异值 %s' % (d[0], d[1], d[2], np.round(s,2)))
proj = (W - c).dot(d)
perp = (W - c) - np.outer(proj, d)
pn = np.linalg.norm(perp, axis=1)
print('  垂直方向残差: 中位 %.1f mm   p90 %.1f mm   max %.1f mm' % (
    1000*np.median(pn), 1000*np.percentile(pn, 90), 1000*pn.max()))
print('  (残差小 = 点排成一条线 = 水槽中心线成立)')

# --- 5) 俯视图 ---
print()
print('=== 俯视图 (x-y 平面, 上=+y) ===')
Wp, Ht = 58, 20
x0,x1 = W[:,0].min(), W[:,0].max(); y0,y1 = W[:,1].min(), W[:,1].max()
sx = max(x1-x0,1e-6); sy = max(y1-y0,1e-6)
g = [[' ']*Wp for _ in range(Ht)]
for p in W:
    gx = int((p[0]-x0)/sx*(Wp-1)); gy = Ht-1-int((p[1]-y0)/sy*(Ht-1))
    if 0<=gy<Ht and 0<=gx<Wp: g[gy][gx]='o'
g[Ht-1-int((W[0,1]-y0)/sy*(Ht-1))][int((W[0,0]-x0)/sx*(Wp-1))] = 'S'
g[Ht-1-int((W[-1,1]-y0)/sy*(Ht-1))][int((W[-1,0]-x0)/sx*(Wp-1))] = 'E'
print('  x %.2f -> %.2f m (格 %.3f m)' % (x0,x1,sx/(Wp-1)))
for r in g: print('  |'+''.join(r)+'|')
print('  y %.2f -> %.2f m (格 %.3f m)   S=起点 E=终点' % (y0,y1,sy/(Ht-1)))

out = os.path.join(os.path.dirname(os.path.abspath(CSVF)), 'polyline.csv')
np.savetxt(out, W, delimiter=',', header='x,y,z', comments='', fmt='%.4f')
print()
print('折线已存 %s' % out)
